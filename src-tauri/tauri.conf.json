{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRCLibMan",
  "mainBinaryName": "VRCLibMan",
  "version": "0.1.9",
  "identifier": "app.vrclibman.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VRCLibMan",
        "width": 1180,
        "height": 800,
        "minWidth": 920,
        "minHeight": 640,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "VRCLibMan",
    "category": "Utility",
    "shortDescription": "手元の VRChat / Booth アセットを整理する",
    "longDescription": "持っている VRChat / Booth のアバターと、同じ素体で着られる衣装・髪・ギミックを、手元の PC だけで整理します。",
    "resources": {
      "resources/wordlists/": "wordlists/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "endpoints": ["https://github.com/KeisXR/VRCLibMan/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["vrclibman"]
      }
    }
  }
}
