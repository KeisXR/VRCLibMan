{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "browser-toolbar",
  "description": "Local browser controls only; remote tab webviews receive no application capabilities",
  "webviews": ["booth-toolbar"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
