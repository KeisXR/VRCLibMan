{
  "manifest_version": 3,
  "name": "VRCLibMan Booth Export",
  "version": "0.1.2",
  "description": "ログイン済みの Booth ページから、今見えている商品だけを JSON で書き出します。パスワードやクッキーはアプリへ渡しません。",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://booth.pm/*", "https://*.booth.pm/*"],
  "action": {
    "default_title": "VRCLibMan に書き出す",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://booth.pm/*", "https://*.booth.pm/*"],
      "js": ["extract.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
